# ===========================================
# AGREE - Environment Configuration
# Copy this file to .env and fill in your values
# ===========================================

# Application
APP_NAME=Agree
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security Keys (GENERATE STRONG RANDOM VALUES!)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_generate_256_bit_secret
JWT_SECRET_KEY=CHANGE_ME_generate_256_bit_jwt_secret
SIGNING_TOKEN_SECRET=CHANGE_ME_generate_256_bit_signing_secret
DATABASE_ENCRYPTION_KEY=CHANGE_ME_generate_32_byte_base64_key

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
SIGNING_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://agree:agree_password@localhost:5432/agree_db

# Redis
REDIS_URL=redis://:agree_redis_password@localhost:6379/0

# Storage - Development (MinIO)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=agree_minio
MINIO_SECRET_KEY=agree_minio_password
MINIO_BUCKET_DOCUMENTS=agree-documents
MINIO_BUCKET_SIGNATURES=agree-signatures
MINIO_BUCKET_THUMBNAILS=agree-thumbnails
MINIO_SECURE=false

# Storage - Production (Google Cloud Storage)
# STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=your-bucket-name
# GCS_CREDENTIALS_PATH=./gcs-credentials.json

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Agree Signing
SENDGRID_SANDBOX_MODE=true

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Whisper (Voice)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
